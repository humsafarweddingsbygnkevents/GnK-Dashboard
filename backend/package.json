{
  "name": "humsafar-gnk-backend",
  "version": "1.0.0",
  "description": "Hotel/venue search API for Humsafar Weddings by GnK",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:seed:artists": "node prisma/seedArtists.js",
    "db:seed:vendors": "node prisma/seedVendors.js",
    "db:reset": "npx prisma migrate reset --force && node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "backup:refresh": "node scripts/refreshBackup.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "imapflow": "^1.4.6",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
