# Humsafar Weddings by GnK backend — environment template. Copy to .env and fill in real values.

# --- Database ---
# Postgres connection string (Neon). Pooled connection used at runtime.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
# Direct (unpooled) connection — used by Prisma for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"
PORT=3000

# --- Google OAuth (Gmail integration) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Admin login (the dashboard is public — this gates it) ---
# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Inbox that receives every signup's permanent access code. Only this address
# ever sees a code — falls back to humsafarweddings@gmail.com if unset.
ADMIN_OTP_EMAIL=
# Same Google Cloud OAuth client as GOOGLE_CLIENT_ID/SECRET above, but a
# SEPARATE redirect URI — this one only requests basic profile/email scope
# for login, never Gmail access. Must be added to the OAuth client's
# "Authorized redirect URIs" in Google Cloud Console alongside GOOGLE_REDIRECT_URI.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Mailbox password encryption ---
# 32-byte-strength secret used (via scrypt) to encrypt IMAP/SMTP mailbox
# passwords at rest. Falls back to JWT_SECRET if unset, but a dedicated key
# means rotating JWT_SECRET won't lock you out of stored mailbox passwords.
MAIL_ENC_KEY=

# --- Login code hashing ---
# Pepper for hashing permanent login codes (HMAC-SHA256). Falls back to
# JWT_SECRET if unset, but a dedicated pepper means rotating JWT_SECRET won't
# also invalidate every stored login code. Generate the same way as JWT_SECRET.
LOGIN_CODE_PEPPER=

# --- OpenRouter (Hwoli agent + dashboard chat) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key
# Model the Hwoli orchestrator drives. Pick one that follows JSON instructions
# reliably (e.g. an instruct/chat model). Example free model shown.
OPENROUTER_MODEL=nex-agi/nex-n2-pro:free

# --- Meta (Instagram DM + Facebook Messenger via unified webhook) ---
# Any string you choose — paste the same value into the Meta App Dashboard's
# webhook "Verify Token" field.
META_VERIFY_TOKEN=choose-any-random-string
# Facebook Page access token (pages_messaging scope) — used for Messenger + Graph API calls on graph.facebook.com.
# Leave blank until approved — the webhook still accepts and stores messages, just can't resolve sender names.
META_PAGE_ACCESS_TOKEN=
# Instagram access token (instagram_business_manage_messages scope) — used for graph.instagram.com calls. Separate token/host from the FB Page token above.
META_IG_ACCESS_TOKEN=
# App Secret from App settings > Basic — used to verify the X-Hub-Signature-256
# header on incoming Facebook Messenger (object: "page") webhook POSTs.
META_APP_SECRET=
# Instagram app secret from the standalone "Instagram API with Instagram Login"
# product page — Meta signs object: "instagram" webhook POSTs with THIS secret,
# not the main App Secret above. Two separate secrets even though both platforms
# share one callback URL.
META_IG_APP_SECRET=

# --- New-client-message webhook (POST /api/webhook/new-client-message) ---
# Internal ingestion endpoint (future Gmail/WhatsApp pollers), not a
# third-party webhook — so nothing signs its payloads for us. Callers must
# send `Authorization: Bearer <this value>`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HWOLI_WEBHOOK_SECRET=
