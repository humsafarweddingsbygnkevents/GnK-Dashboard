{
  "permissions": {
    "deny": [
      "Bash(npx prisma migrate:*)",
      "Bash(npx prisma db:*)",
      "Bash(prisma migrate:*)",
      "Bash(prisma db:*)",
      "Bash(npm run db:seed:*)",
      "Bash(npm run db:reset:*)",
      "Bash(npm run db:migrate:*)",
      "Bash(psql:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_restore:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-db-writes.sh\"",
            "timeout": 10,
            "statusMessage": "Checking command against database guard"
          }
        ]
      }
    ]
  }
}
